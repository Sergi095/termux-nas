+static int is_write_open(Tracee *tracee, Sysnum sysnum)
+{
+    uint64_t flags;
+    int status;
+    if (sysnum == PR_creat) return 1;
+    if (sysnum == PR_open)
+        flags = peek_reg(tracee, ORIGINAL, SYSARG_2);
+    else if (sysnum == PR_openat)
+        flags = peek_reg(tracee, ORIGINAL, SYSARG_3);
+    else if (sysnum == PR_openat2) {
+        status = read_data(tracee, &flags,
+                           peek_reg(tracee, ORIGINAL, SYSARG_3), sizeof(flags));
+        if (status < 0) return 1;
+    }
+    else return 0;
+    return (flags & O_ACCMODE) != O_RDONLY ||
+           (flags & (O_CREAT | O_TRUNC | O_APPEND)) != 0;
+}
+
+static int is_write_path(Sysnum sysnum)
+{
+    switch (sysnum) {
+    case PR_mkdir: case PR_mkdirat: case PR_mknod: case PR_mknodat:
+    case PR_unlink: case PR_unlinkat: case PR_rmdir:
+    case PR_rename: case PR_renameat: case PR_renameat2:
+    case PR_link: case PR_linkat: case PR_symlink: case PR_symlinkat:
+    case PR_chmod: case PR_fchmodat: case PR_fchmodat2:
+    case PR_chown: case PR_lchown: case PR_fchownat:
+    case PR_truncate: case PR_utime: case PR_utimes: case PR_utimensat:
+    case PR_setxattr: case PR_lsetxattr: case PR_removexattr:
+    case PR_lremovexattr:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
 int nasfs_callback(Extension *extension, ExtensionEvent event, intptr_t d1, intptr_t d2)
 {
