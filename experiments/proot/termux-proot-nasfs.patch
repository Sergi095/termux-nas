diff --git a/src/extension/nasfs/nasfs.c b/src/extension/nasfs/nasfs.c
new file mode 100644
index 0000000..3d8b671
--- /dev/null
+++ b/src/extension/nasfs/nasfs.c
@@ -0,0 +1,128 @@
+/* Read-only NAS filesystem hydration experiment for PRoot. */
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "extension/extension.h"
+#include "syscall/sysnum.h"
+#include "tracee/mem.h"
+
+static int full_write(int fd, const void *buffer, size_t size)
+{
+    const char *data = buffer;
+    while (size > 0) {
+        ssize_t count = write(fd, data, size);
+        if (count <= 0) return -1;
+        data += count;
+        size -= count;
+    }
+    return 0;
+}
+
+static int hydrate(const char *path, char action)
+{
+    const char *socket_path = getenv("PROOT_NAS_SOCKET");
+    struct sockaddr_un address;
+    uint32_t length;
+    char reply;
+    int fd;
+
+    if (socket_path == NULL || strlen(socket_path) >= sizeof(address.sun_path))
+        return -EIO;
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) return -EIO;
+    memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, socket_path);
+    if (connect(fd, (struct sockaddr *) &address, sizeof(address)) < 0) {
+        close(fd);
+        return -EIO;
+    }
+    length = htonl((uint32_t) strlen(path));
+    if (full_write(fd, &action, 1) < 0 ||
+        full_write(fd, &length, sizeof(length)) < 0 ||
+        full_write(fd, path, strlen(path)) < 0 ||
+        read(fd, &reply, 1) != 1) {
+        close(fd);
+        return -EIO;
+    }
+    close(fd);
+    if (reply == '0') return 0;
+    if (reply == '1') return -ENOENT;
+    return -EIO;
+}
+
+static int is_write_open(Tracee *tracee, Sysnum sysnum)
+{
+    uint64_t flags;
+    int status;
+    if (sysnum == PR_creat) return 1;
+    if (sysnum == PR_open)
+        flags = peek_reg(tracee, ORIGINAL, SYSARG_2);
+    else if (sysnum == PR_openat)
+        flags = peek_reg(tracee, ORIGINAL, SYSARG_3);
+    else if (sysnum == PR_openat2) {
+        status = read_data(tracee, &flags,
+                           peek_reg(tracee, ORIGINAL, SYSARG_3), sizeof(flags));
+        if (status < 0) return 1;
+    }
+    else return 0;
+    return (flags & O_ACCMODE) != O_RDONLY ||
+           (flags & (O_CREAT | O_TRUNC | O_APPEND)) != 0;
+}
+
+static int is_write_path(Sysnum sysnum)
+{
+    switch (sysnum) {
+    case PR_mkdir: case PR_mkdirat: case PR_mknod: case PR_mknodat:
+    case PR_unlink: case PR_unlinkat: case PR_rmdir:
+    case PR_rename: case PR_renameat: case PR_renameat2:
+    case PR_link: case PR_linkat: case PR_symlink: case PR_symlinkat:
+    case PR_chmod: case PR_fchmodat: case PR_fchmodat2:
+    case PR_chown: case PR_lchown: case PR_fchownat:
+    case PR_truncate: case PR_utime: case PR_utimes: case PR_utimensat:
+    case PR_setxattr: case PR_lsetxattr: case PR_removexattr:
+    case PR_lremovexattr:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+int nasfs_callback(Extension *extension, ExtensionEvent event, intptr_t d1, intptr_t d2)
+{
+    const char *mount;
+    const char *base;
+    const char *user;
+    char path[PATH_MAX];
+    Sysnum sysnum;
+    char action;
+    int length;
+    if (event == INHERIT_PARENT) return 0;
+    if (event != GUEST_PATH) return 0;
+
+    mount = getenv("PROOT_NAS_MOUNT");
+    if (mount == NULL) return 0;
+    base = (const char *) d1;
+    user = (const char *) d2;
+    if (user[0] == '/') length = snprintf(path, sizeof(path), "%s", user);
+    else length = snprintf(path, sizeof(path), "%s/%s", base, user);
+    if (length < 0 || (size_t) length >= sizeof(path)) return -ENAMETOOLONG;
+    if (strncmp(path, mount, strlen(mount)) != 0 ||
+        (path[strlen(mount)] != '/' && path[strlen(mount)] != '\0'))
+        return 0;
+    sysnum = get_sysnum(TRACEE(extension), ORIGINAL);
+    if (is_write_path(sysnum) || is_write_open(TRACEE(extension), sysnum))
+        return -EROFS;
+    action = (sysnum == PR_open || sysnum == PR_openat ||
+              sysnum == PR_openat2 || sysnum == PR_creat) ? 'O' : 'M';
+    return hydrate(path, action);
+}
